# ───────────── Notion Internal Integration (마스터 클라이언트) ─────────────
# https://www.notion.so/profile/integrations > New integration > Internal
NOTION_INTEGRATION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───────────── Notion OAuth App ─────────────
# https://www.notion.so/profile/integrations > New integration > Public
NOTION_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

# ───────────── 시스템 Notion DB ID ─────────────
# 시스템 DB 3개 생성 후 URL에서 32자리 hex 추출
# https://notion.so/workspace/[32자리-hex]?v=...
NOTION_USERS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_INTEGRATIONS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_INVOICES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───────────── JWT 인증 ─────────────
# openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ───────────── 앱 공개 URL ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
